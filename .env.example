# Copy to .env (git-ignored). Used only by dev runs and the smoke tests — never by the installed app.

# Your Discord user token. Dev builds sign in with it automatically.
DISCORD_TOKEN=

# Optional: a text channel in a server YOU OWN where write tests may post, react, edit and delete
# (`pnpm smoke:write`, and `shoot.mjs --write`). Leave empty to skip write tests.
MINICORD_TEST_CHANNEL_ID=
