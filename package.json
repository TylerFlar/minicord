{
  "name": "minicord",
  "private": true,
  "version": "0.1.2",
  "description": "A calm Discord client for Windows and Android",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TylerFlar/minicord.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @minicord/desktop dev",
    "build": "pnpm -r --filter=!@minicord/android build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "smoke": "pnpm --filter @minicord/core smoke",
    "smoke:write": "pnpm --filter @minicord/core smoke:write",
    "smoke:notify": "pnpm --filter @minicord/core smoke:notify",
    "android": "pnpm --filter @minicord/android build",
    "test:native": "pnpm --filter @minicord/android test:native",
    "release": "node scripts/release.mjs",
    "dist:win": "pnpm --filter @minicord/desktop dist",
    "dist:android": "pnpm --filter @minicord/android dist",
    "screenshots": "pnpm --filter @minicord/desktop screenshots",
    "demo": "pnpm --filter @minicord/desktop demo"
  }
}
